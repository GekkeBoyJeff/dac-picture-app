# --- Supabase Realtime: transport voor de /admin remote-bediening ---
# Publieke waarden (komen sowieso in de client-bundle) — veilig om te delen.
# Zet deze ook als GitHub Actions *Variables* (niet Secrets) voor de deploy-build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Wachtwoord voor /admin (operator-only). Zichtbaar in de JS-bundle — prima voor
# een photobooth; het weert casual toegang en wordt meegestuurd in commando's
# zodat de booth alleen geverifieerd verkeer uitvoert.
NEXT_PUBLIC_REMOTE_PASSWORD=changeme
